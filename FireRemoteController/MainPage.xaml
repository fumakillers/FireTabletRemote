<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FireRemoteController.MainPage"
             Title="Fire Remote Controller">
    <Grid ColumnDefinitions="*,72">
        <Border Grid.Column="0" Margin="12,12,6,12" Padding="0"
                StrokeShape="RoundRectangle 12" StrokeThickness="1">
            <Grid x:Name="PreviewInputArea" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnPreviewPointerPressed"
                                              PointerMoved="OnPreviewPointerMoved"
                                              PointerReleased="OnPreviewPointerReleased"
                                              PointerExited="OnPreviewPointerExited" />
                </Grid.GestureRecognizers>
                <Image x:Name="PreviewImage" Aspect="AspectFit"
                       HorizontalOptions="Fill" VerticalOptions="Fill"
                       InputTransparent="True" />
                <VerticalStackLayout x:Name="PreviewPlaceholder"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     InputTransparent="True">
                    <Label Text="Future landscape preview area" FontSize="24"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Tap to inspect local preview coordinates."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="6,12,6,12"
              RowDefinitions="Auto,Auto,*,*,*" RowSpacing="8">
            <Button x:Name="SettingsButton" Grid.Row="0" Text="&#x2699;" FontSize="22"
                    WidthRequest="56" HeightRequest="56"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Connection settings"
                    Clicked="OnSettingsClicked" />
            <Border x:Name="ConnectionStateIndicator" Grid.Row="1"
                    WidthRequest="40" HeightRequest="40"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#9E9E9E" Stroke="#616161" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    SemanticProperties.Description="Disconnected" />
            <Grid Grid.Row="1" WidthRequest="40" HeightRequest="40"
                  HorizontalOptions="Center" VerticalOptions="Center"
                  InputTransparent="True">
                <Label x:Name="ConnectionStateGlyph" Text="&#x2194;" FontSize="20"
                       TextColor="White" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       InputTransparent="True" />
                <Label x:Name="ConnectionStateBadge" Text="&#x00D7;" FontSize="13"
                       TextColor="White" FontAttributes="Bold"
                       Margin="0,0,5,2"
                       HorizontalOptions="End" VerticalOptions="End"
                       InputTransparent="True" />
            </Grid>
            <Button x:Name="BackButton" Grid.Row="2" Text="&#x25C0;" FontSize="22"
                    IsEnabled="False" WidthRequest="56" HeightRequest="56"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    SemanticProperties.Description="Back"
                    Clicked="OnBackClicked" />
            <Button x:Name="HomeButton" Grid.Row="3" Text="&#x25CF;" FontSize="22"
                    IsEnabled="False" WidthRequest="56" HeightRequest="56"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    SemanticProperties.Description="Home"
                    Clicked="OnHomeClicked" />
            <Button x:Name="RecentsButton" Grid.Row="4" Text="&#x25A0;" FontSize="22"
                    IsEnabled="False" WidthRequest="56" HeightRequest="56"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    SemanticProperties.Description="Recents"
                    Clicked="OnRecentsClicked" />
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" IsVisible="False"
              BackgroundColor="#99000000" ZIndex="10">
            <Border WidthRequest="560" MaximumHeightRequest="390" Padding="20"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#FFFBFE, Dark=#1C1B1F}"
                    StrokeShape="RoundRectangle 12" StrokeThickness="1">
                <ScrollView VerticalScrollBarVisibility="Default">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Connection Settings" FontSize="22" FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Grid ColumnDefinitions="*,140" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="Server IP" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Port" />
                            <Entry x:Name="ServerIpEntry" Grid.Row="1" Grid.Column="0"
                                   AutomationId="ServerIpEntry" Keyboard="Numeric" MaxLength="15"
                                   ClearButtonVisibility="WhileEditing"
                                   SemanticProperties.Hint="Fire Tablet IPv4 address"
                                   TextChanged="OnServerIpTextChanged" />
                            <Entry x:Name="PortEntry" Grid.Row="1" Grid.Column="1"
                                   AutomationId="PortEntry" Keyboard="Numeric" MaxLength="5"
                                   TextChanged="OnPortTextChanged" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="ConnectButton" Text="Connect"
                                    Clicked="OnConnectClicked" />
                            <Button x:Name="DisconnectButton" Text="Disconnect" IsEnabled="False"
                                    Clicked="OnDisconnectClicked" />
                        </HorizontalStackLayout>
                        <Label x:Name="StatusLabel" Text="Status: Disconnected"
                               FontAttributes="Bold" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button x:Name="SendPingButton" Grid.Column="0" Text="Send test ping"
                                    IsEnabled="False" HorizontalOptions="Fill"
                                    Clicked="OnSendPingClicked" />
                            <Button Grid.Column="1" Text="Close"
                                    Clicked="OnCloseSettingsClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
