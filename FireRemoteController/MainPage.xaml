<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FireRemoteController.MainPage"
             Title="Fire Remote Controller">
    <Grid Padding="24,12" ColumnDefinitions="320,*" ColumnSpacing="24" RowDefinitions="*">
        <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="8">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Spacing="6" VerticalOptions="Start">
                    <Label Text="Fire Remote Controller" FontAttributes="Bold" FontSize="24"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Server IP" />
                    <Entry x:Name="ServerIpEntry" Text="192.168.196.202" Keyboard="Url"
                           ClearButtonVisibility="WhileEditing"
                           SemanticProperties.Hint="Fire Tablet IP address" />
                    <Label Text="Port" />
                    <Entry x:Name="PortEntry" Text="8080" Keyboard="Numeric" MaxLength="5" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
                        <Button x:Name="DisconnectButton" Text="Disconnect" IsEnabled="False"
                                Clicked="OnDisconnectClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
            <Label x:Name="StatusLabel" Grid.Row="1" Text="Status: Disconnected"
                   FontAttributes="Bold" LineBreakMode="WordWrap" />
        </Grid>

        <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
                <Grid x:Name="PreviewInputArea" Grid.Row="0" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviewTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Future landscape preview area" FontSize="22"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Tap to inspect local preview coordinates."
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button x:Name="BackButton" Grid.Column="0" Text="&#x25C0;" FontSize="22"
                            IsEnabled="False" MinimumHeightRequest="56"
                            SemanticProperties.Description="Back"
                            Clicked="OnBackClicked" />
                    <Button x:Name="HomeButton" Grid.Column="1" Text="&#x25CF;" FontSize="22"
                            IsEnabled="False" MinimumHeightRequest="56"
                            SemanticProperties.Description="Home"
                            Clicked="OnHomeClicked" />
                    <Button x:Name="RecentsButton" Grid.Column="2" Text="&#x25A0;" FontSize="22"
                            IsEnabled="False" MinimumHeightRequest="56"
                            SemanticProperties.Description="Recents"
                            Clicked="OnRecentsClicked" />
                </Grid>

                <Button x:Name="SendPingButton" Grid.Row="2" Text="Send test ping"
                        IsEnabled="False" HorizontalOptions="Fill" Clicked="OnSendPingClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
